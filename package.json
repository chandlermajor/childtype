{
  "name": "childtype",
  "version": "0.1.0",
  "description": "帮助小朋友学习键盘指法并练习速度的浏览器插件",
  "private": true,
  "scripts": {
    "build:firefox": "BROWSER=firefox npx webpack --config webpack.config.ts",
    "build:chrome": "BROWSER=chrome npx webpack --config webpack.config.ts",
    "build": "npm run build:firefox && npm run build:chrome",
    "dev:firefox": "BROWSER=firefox npx webpack --config webpack.config.ts --watch",
    "dev:chrome": "BROWSER=chrome npx webpack --config webpack.config.ts --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf build"
  },
  "keywords": ["typing", "education", "firefox", "chrome"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^20.11.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.9.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
